# Copy to .env — one key, one owner (§13 Phase 0).
# The hub runs WITHOUT this: every slow-path model call degrades to the
# deterministic path if the key is absent. Nothing in the fast path uses it.
ANTHROPIC_API_KEY=

# Port for hooks + MCP + board websocket (one process, §12).
PORT=8787

# Bind address. MUST stay 0.0.0.0 for cross-machine — "localhost" is the
# #1 failure mode called out in §12.
HOST=0.0.0.0

# Lease time-to-live in milliseconds.
LEASE_TTL_MS=600000

# Append every mutation to switchboard.jsonl (§7, optional).
PERSIST_JSONL=false
