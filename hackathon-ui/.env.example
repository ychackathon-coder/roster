# Copy to .env.local
#
# Where the roster API lives. The dashboard reads /api/profile and /api/events
# from here and POSTs to /api/hq.
#
# Local dev: roster runs on 3456, this dashboard on 3000 (or 3001).
NEXT_PUBLIC_ROSTER_API_BASE_URL=http://localhost:3456

# Leave EMPTY when both apps are served from one domain in production — an empty
# value means same-origin, which avoids CORS entirely.
# NEXT_PUBLIC_ROSTER_API_BASE_URL=
